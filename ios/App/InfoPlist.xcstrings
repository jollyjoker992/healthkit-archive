{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Backup"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu sức khoẻ"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera scans invite and processor QR codes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera được dùng để quét mã QR tham gia và thẻ máy giải mã."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Backup reads your Health data to back it up, encrypted on this phone, for the processors you choose."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đọc dữ liệu sức khỏe để sao lưu. Dữ liệu được mã hóa ngay trên điện thoại và chỉ những máy giải mã bạn chọn mới đọc được."
          }
        }
      }
    }
  },
  "version": "1.0"
}
