{
  "sourceLanguage": "en",
  "strings": {
    "%@ of %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trên %2$@"
          }
        }
      }
    },
    "%@ stored on the server": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã lưu trên máy chủ"
          }
        }
      }
    },
    "%lld encrypted files are queued. iOS uploads them in the background.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld encrypted file is queued. iOS uploads it in the background."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld encrypted files are queued. iOS uploads them in the background."
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tệp đã mã hóa đang chờ. iOS sẽ tự tải lên khi có thể."
          }
        }
      }
    },
    "A private backup of your Health data for your family.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu riêng tư cho dữ liệu sức khỏe của bạn, lưu trên máy chủ của gia đình."
          }
        }
      }
    },
    "A processor checks this fingerprint before it accepts data from this iPhone.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy giải mã sẽ đối chiếu mã này trước khi nhận dữ liệu từ iPhone này."
          }
        }
      }
    },
    "A processor is a computer that holds a key to your backup, usually your family’s.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy giải mã là máy tính giữ chìa khóa mở bản sao lưu của bạn, thường là máy tính chung của gia đình."
          }
        }
      }
    },
    "Add Processor": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm máy giải mã"
          }
        }
      }
    },
    "Add a processor. Nothing is uploaded until someone can read it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm máy giải mã. Dữ liệu chỉ được tải lên khi đã có máy đọc được."
          }
        }
      }
    },
    "Allow the camera in Settings, or paste the code instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật quyền camera trong Cài đặt, hoặc dán mã vào đây."
          }
        }
      }
    },
    "Ask your family’s admin for an invite code.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xin mã tham gia từ người quản lý của gia đình."
          }
        }
      }
    },
    "Back Up Now": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu ngay"
          }
        }
      }
    },
    "Backed up": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao lưu"
          }
        }
      }
    },
    "Backing up for": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu cho"
          }
        }
      }
    },
    "Backing up…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang sao lưu…"
          }
        }
      }
    },
    "Backup Details": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi tiết sao lưu"
          }
        }
      }
    },
    "Backup is out of date": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lâu chưa sao lưu"
          }
        }
      }
    },
    "Backup not collected": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu chưa được nhận"
          }
        }
      }
    },
    "Backup paused": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu tạm dừng"
          }
        }
      }
    },
    "Backup stopped": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu đã dừng"
          }
        }
      }
    },
    "Belongs to": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của"
          }
        }
      }
    },
    "Camera Access Is Off": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cho phép dùng camera"
          }
        }
      }
    },
    "Camera Not Available": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dùng được camera"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy"
          }
        }
      }
    },
    "Check these with your admin. The invite can be used once.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác nhận thông tin này với người quản lý. Mỗi mã tham gia chỉ dùng được một lần."
          }
        }
      }
    },
    "Checked %@. Pull down to check again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kiểm tra %@. Kéo xuống để kiểm tra lại."
          }
        }
      }
    },
    "Collected %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nhận %@"
          }
        }
      }
    },
    "Compare this with the fingerprint on the processor’s screen. If they match, it will be able to read everything backed up from now on.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy so với mã đang hiển thị trên máy đó. Nếu giống nhau, máy này sẽ đọc được mọi dữ liệu sao lưu từ bây giờ."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục"
          }
        }
      }
    },
    "Copy the code on another device and paste it here.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy sao chép mã từ thiết bị khác rồi dán vào đây."
          }
        }
      }
    },
    "Couldn’t back up": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không sao lưu được"
          }
        }
      }
    },
    "Couldn’t join": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tham gia được"
          }
        }
      }
    },
    "Couldn’t open this iPhone’s key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được chìa khóa của iPhone này"
          }
        }
      }
    },
    "Couldn’t re-send history": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gửi lại được dữ liệu"
          }
        }
      }
    },
    "Couldn’t request Health access": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xin được quyền đọc dữ liệu sức khỏe"
          }
        }
      }
    },
    "Couldn’t start over": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt đầu lại được"
          }
        }
      }
    },
    "Couldn’t update processors": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cập nhật được danh sách máy giải mã"
          }
        }
      }
    },
    "Daily check": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra hằng ngày"
          }
        }
      }
    },
    "Data is locked before it leaves the phone. The server stores it but cannot read it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu được mã hóa trước khi rời khỏi máy. Máy chủ chỉ lưu giữ, không thể đọc được."
          }
        }
      }
    },
    "Data types not shared": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại dữ liệu chưa cho phép"
          }
        }
      }
    },
    "Each upload is encrypted on this iPhone. Only your processors can open it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần tải lên đều được mã hóa trên iPhone này. Chỉ các máy giải mã của bạn mới mở được."
          }
        }
      }
    },
    "Earlier history": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử trước đây"
          }
        }
      }
    },
    "Encrypted on this iPhone": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã hóa ngay trên iPhone"
          }
        }
      }
    },
    "Fingerprint": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đối chiếu"
          }
        }
      }
    },
    "Fingerprint %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đối chiếu %@"
          }
        }
      }
    },
    "Fingerprints Match, Add": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã giống nhau, thêm máy"
          }
        }
      }
    },
    "Finish setting up": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất cài đặt"
          }
        }
      }
    },
    "Health Backup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu dữ liệu sức khỏe"
          }
        }
      }
    },
    "Health data can only be read while the iPhone is unlocked.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho phép đọc dữ liệu sức khỏe khi iPhone đang mở khóa."
          }
        }
      }
    },
    "If this processor loses its key, the backup cannot be read. Add a recovery card as a second one.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu máy này mất chìa khóa, bản sao lưu sẽ không mở được nữa. Nên thêm thẻ khôi phục làm máy thứ hai."
          }
        }
      }
    },
    "It gets nothing new. What it already downloaded stays readable to it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy này sẽ không nhận được dữ liệu mới. Những gì đã tải về trước đó, máy vẫn đọc được."
          }
        }
      }
    },
    "It matches the fingerprint this processor shows with “hka card”.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã này giống với mã mà lệnh “hka card” hiển thị trên máy đó."
          }
        }
      }
    },
    "Join": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham gia"
          }
        }
      }
    },
    "Keep the app open until this finishes.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng giữ ứng dụng mở cho đến khi xong."
          }
        }
      }
    },
    "Last backup %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần sao lưu gần nhất: %@."
          }
        }
      }
    },
    "Last backup %@. Unlock the phone and tap Back Up Now.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần sao lưu gần nhất: %@. Hãy mở khóa điện thoại và chạm Sao lưu ngay."
          }
        }
      }
    },
    "Last problem": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi gần nhất"
          }
        }
      }
    },
    "Last read from Health": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đọc gần nhất"
          }
        }
      }
    },
    "Last received": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận gần nhất"
          }
        }
      }
    },
    "Last upload": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần tải lên gần nhất"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên máy"
          }
        }
      }
    },
    "Name of this iPhone": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên iPhone này"
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có"
          }
        }
      }
    },
    "New Health data": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu Sức khỏe mới"
          }
        }
      }
    },
    "New Health data is backed up while the phone is unlocked.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu sức khỏe mới được sao lưu khi điện thoại đang mở khóa."
          }
        }
      }
    },
    "New backups will no longer be readable by it. Files already waiting to upload still are.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy này sẽ không đọc được dữ liệu sao lưu mới. Riêng các tệp đang chờ tải lên thì máy vẫn đọc được."
          }
        }
      }
    },
    "Next, iOS asks which Health data to share. Choose Turn On All to back up everything. The app only reads Health data.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo, iOS sẽ hỏi bạn muốn chia sẻ những dữ liệu sức khỏe nào. Hãy chọn Bật tất cả để sao lưu đầy đủ. Ứng dụng chỉ đọc, không thay đổi dữ liệu của bạn."
          }
        }
      }
    },
    "No one yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có máy nào"
          }
        }
      }
    },
    "No processor has collected your backup since %@. Ask your admin to check it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa máy giải mã nào nhận bản sao lưu của bạn kể từ %@. Hãy nhờ người quản lý kiểm tra."
          }
        }
      }
    },
    "None yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có"
          }
        }
      }
    },
    "Not backed up yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa sao lưu lần nào"
          }
        }
      }
    },
    "Not checked yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa kiểm tra"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "On the server": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên máy chủ"
          }
        }
      }
    },
    "On this iPhone": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên iPhone này"
          }
        }
      }
    },
    "Only the processors you add can unlock your backup. You can remove them later.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những máy giải mã bạn thêm vào mới mở được bản sao lưu. Bạn có thể gỡ chúng bất cứ lúc nào."
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt"
          }
        }
      }
    },
    "Point the camera at the QR code shown by “hka card”.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa camera vào mã QR mà lệnh “hka card” hiển thị trên máy tính."
          }
        }
      }
    },
    "Point the camera at the invite QR code from your admin.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa camera vào mã QR tham gia mà người quản lý gửi cho bạn."
          }
        }
      }
    },
    "Re-send All History": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi lại toàn bộ dữ liệu"
          }
        }
      }
    },
    "Re-send All History…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi lại toàn bộ dữ liệu…"
          }
        }
      }
    },
    "Re-send all history?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi lại toàn bộ dữ liệu?"
          }
        }
      }
    },
    "Recent uploads": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần tải lên gần đây"
          }
        }
      }
    },
    "Remove %@?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ %@?"
          }
        }
      }
    },
    "Remove Processor": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ máy giải mã"
          }
        }
      }
    },
    "Review Health Access": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra quyền đọc dữ liệu sức khỏe"
          }
        }
      }
    },
    "Runs in the background": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động chạy nền"
          }
        }
      }
    },
    "Scan Invite": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã tham gia"
          }
        }
      }
    },
    "Scan Processor Card": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét thẻ máy giải mã"
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ"
          }
        }
      }
    },
    "Size": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng"
          }
        }
      }
    },
    "Start Over": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu lại"
          }
        }
      }
    },
    "Start Over as a New Device": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu lại như máy mới"
          }
        }
      }
    },
    "Start over as a new device?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu lại như máy mới?"
          }
        }
      }
    },
    "Storage used": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng đã dùng"
          }
        }
      }
    },
    "Tap Back Up Now to start.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm Sao lưu ngay để bắt đầu."
          }
        }
      }
    },
    "That is not a valid code. It starts with “%@”.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã không đúng. Mã hợp lệ bắt đầu bằng “%@”."
          }
        }
      }
    },
    "The server has no room left for your backup. Ask your admin to raise the limit.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đã hết dung lượng dành cho bạn. Hãy nhờ người quản lý tăng giới hạn."
          }
        }
      }
    },
    "The server refuses uploads from this iPhone. Ask your admin to retire it, then start over.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ không nhận dữ liệu từ iPhone này nữa. Hãy nhờ người quản lý gỡ thiết bị này, sau đó bắt đầu lại."
          }
        }
      }
    },
    "This iPhone": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này"
          }
        }
      }
    },
    "This iPhone forgets its key and needs a new invite. Ask your admin to retire the old device first. What is already backed up stays readable.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này sẽ xóa chìa khóa hiện tại và cần mã tham gia mới. Hãy nhờ người quản lý gỡ thiết bị cũ trước. Dữ liệu đã sao lưu vẫn đọc được bình thường."
          }
        }
      }
    },
    "This is the only processor. Add another before removing it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là máy giải mã duy nhất. Hãy thêm máy khác trước khi gỡ."
          }
        }
      }
    },
    "This processor is already on your list.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy này đã có trong danh sách."
          }
        }
      }
    },
    "To change what is shared later, open the Health app, tap your picture, then Apps.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thay đổi quyền sau này, hãy mở ứng dụng Sức khỏe, chạm vào ảnh đại diện, rồi chọn Ứng dụng."
          }
        }
      }
    },
    "Uploads everything in Health again so a newly added processor can read older data. This can take a while and uses data.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ dữ liệu trong ứng dụng Sức khỏe sẽ được tải lên lại để máy giải mã mới thêm đọc được cả dữ liệu cũ. Việc này có thể mất khá lâu và tốn dung lượng mạng."
          }
        }
      }
    },
    "Uploads stored": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lần tải lên đã lưu"
          }
        }
      }
    },
    "Waiting to upload": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ tải lên"
          }
        }
      }
    },
    "Weekly count": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thống kê hằng tuần"
          }
        }
      }
    },
    "Who can read this backup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai có thể đọc bản sao lưu"
          }
        }
      }
    },
    "You choose who can read it": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn quyết định ai được đọc"
          }
        }
      }
    }
  },
  "version": "1.0"
}
