{
  // hka relay: stores ciphertext in R2 and the allowlist/index in D1. See ../spec/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hka-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BATCHES", "bucket_name": "hka-batches" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hka",
      // Replace with the id printed by `wrangler d1 create hka`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [{ "name": "ENROLL_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Hourly purge job: deletes objects of purged devices once retention allows.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    // Set to the deployed origin, e.g. "https://hka-relay.<account>.workers.dev". Used in signed requests.
    "ORIGIN": "http://localhost:8787",
    // JSON object of admin ids to public keys, from `hka-admin init`. Public keys are not secret.
    "ADMIN_KEYS": "{}",
    "MAX_BATCH_BYTES": "8388608",
    "DEVICE_DAILY_BYTES": "536870912",
    "USER_TOTAL_BYTES": "21474836480",
    "SEQ_WINDOW": "64"
  }
}
